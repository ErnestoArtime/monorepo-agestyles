{
  "name": "monorepo-agestyles",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "lab:init": "node tools/scripts/mercur-lab-env.mjs api",
    "lab:up": "pnpm run lab:init && docker compose --env-file apps/commerce-api/.env -f infra/compose/mercur-lab.yaml up -d --wait",
    "lab:down": "docker compose --env-file apps/commerce-api/.env -f infra/compose/mercur-lab.yaml stop",
    "lab:logs": "docker compose --env-file apps/commerce-api/.env -f infra/compose/mercur-lab.yaml logs --tail=100",
    "lab:migrate": "pnpm --filter @agestyles/commerce-api migrate",
    "lab:seed": "pnpm --filter @agestyles/commerce-api seed",
    "lab:buyer": "node tools/scripts/mercur-lab-env.mjs buyer",
    "lab:business": "node tools/scripts/mercur-lab-env.mjs business",
    "lab:verify:seller-roles": "node --env-file=apps/buyer-app/.env.local apps/commerce-api/scripts/verify-seller-roles.mjs",
    "lab:verify:kickz-roles": "node --env-file=apps/buyer-app/.env.local apps/commerce-api/scripts/verify-kickz-store-roles.mjs",
    "lab:verify:memberships": "node --env-file=apps/buyer-app/.env.local tools/scripts/verify-multistore-memberships.mjs",
    "lab:verify:multistore-checkout": "node --env-file=apps/buyer-app/.env.local apps/commerce-api/scripts/verify-multistore-checkout.mjs",
    "lab:verify:order-quotes": "node --env-file=apps/commerce-api/.env --env-file=apps/buyer-app/.env.local apps/commerce-api/scripts/verify-order-quotes.mjs",
    "lab:verify:dual-identity": "node --env-file=apps/buyer-app/.env.local apps/commerce-api/scripts/verify-dual-actor-identity.mjs",
    "lab:api": "pnpm --filter @agestyles/commerce-api start",
    "lab:app": "pnpm --filter @agestyles/buyer-app start",
    "lab:business-app": "pnpm --filter @agestyles/business-app start",
    "lab:web:build": "pnpm --filter @agestyles/buyer-app exec expo export --platform web",
    "lab:web:build:public": "node tools/scripts/build-buyer-web.mjs",
    "seller:web:build": "node --env-file=apps/business-app/.env.local tools/scripts/build-business-web.mjs",
    "lab:web:serve": "python3 -m http.server 18081 --bind 127.0.0.1 --directory apps/buyer-app/dist",
    "migration:catalog:check": "node tools/migration/validate-stage-bundle.mjs --profile catalog-only",
    "migration:catalog:project": "node tools/migration/project-catalog-projection.mjs",
    "migration:catalog:export": "node tools/migration/export-public-supabase-catalog.mjs",
    "migration:catalog:import": "node tools/migration/import-catalog-bundle-to-medusa.mjs",
    "migration:test": "node --test tools/migration/test/validate-stage-bundle.test.mjs",
    "test": "nx run-many --target=test",
    "typecheck": "nx run-many --target=typecheck",
    "typecheck:quick": "nx run-many --target=typecheck --exclude=@agestyles/commerce-api",
    "lint": "eslint .",
    "format:check": "node --input-type=module -e 'import { execFileSync, spawnSync } from \"node:child_process\"; const base = process.env.FORMAT_BASE_REF; const diffArgs = [\"diff\", \"--name-only\", \"--diff-filter=ACMR\", ...(base ? [`${base}...HEAD`] : [\"HEAD\"]), \"--\"]; const files = execFileSync(\"git\", diffArgs, { encoding: \"utf8\" }).split(/\\r?\\n/).filter((file) => /\\.(?:cjs|css|html|js|json|jsonc|jsx|mjs|scss|ts|tsx|yaml|yml)$/.test(file) && !file.startsWith(\"references/\")); if (!files.length) { console.log(\"No changed supported files to format-check.\"); process.exit(0); } const result = spawnSync(\"prettier\", [\"--check\", ...files], { stdio: \"inherit\" }); process.exit(result.status ?? 1);'"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "eslint": "9.39.2",
    "eslint-config-expo": "10.0.0",
    "eslint-config-next": "16.4.6",
    "globals": "16.5.0",
    "nx": "24.0.6",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
