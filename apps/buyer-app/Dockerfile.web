FROM node:24-bookworm-slim AS builder

WORKDIR /workspace
RUN corepack enable

COPY . .
RUN pnpm install --frozen-lockfile

ARG EXPO_PUBLIC_MEDUSA_URL
ARG EXPO_PUBLIC_MEDUSA_PUBLISHABLE_API_KEY
ARG EXPO_PUBLIC_ANDROID_APK_URL=
ENV EXPO_PUBLIC_MEDUSA_URL=$EXPO_PUBLIC_MEDUSA_URL
ENV EXPO_PUBLIC_MEDUSA_PUBLISHABLE_API_KEY=$EXPO_PUBLIC_MEDUSA_PUBLISHABLE_API_KEY
ENV EXPO_PUBLIC_ANDROID_APK_URL=$EXPO_PUBLIC_ANDROID_APK_URL
ENV EXPO_NO_TELEMETRY=1

RUN pnpm --filter @agestyles/buyer-app exec expo export --platform web

FROM nginx:alpine AS web
COPY apps/buyer-app/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /workspace/apps/buyer-app/dist /usr/share/nginx/html
EXPOSE 80
