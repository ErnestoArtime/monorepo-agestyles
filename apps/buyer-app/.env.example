EXPO_PUBLIC_MEDUSA_URL=http://127.0.0.1:19081
EXPO_PUBLIC_MEDUSA_PUBLISHABLE_API_KEY=
EXPO_PUBLIC_ANDROID_APK_URL=

# Set only in the ignored .env.local file; never commit the value.
AGESTYLES_LAB_SEEDED_PASSWORD=
# Optional disposable buyer identity for dual-actor integration checks.
DUAL_AUTH_LAB_EMAIL=
DUAL_AUTH_LAB_PASSWORD=
# Google Analytics 4 in Tienda web (AG-59, Fase 4): same GA4 property as the
# catalog, when Ernesto creates it. Empty until then; without it GA4 stays
# inactive even if the visitor accepts cookies. The native Android app does
# not use this value. Never commit a real ID.
EXPO_PUBLIC_GA_MEASUREMENT_ID=
