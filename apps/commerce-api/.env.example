# AgeStyles Commerce API — example environment (NO real values)
#
# Copy to a PRIVATE file (lab: apps/commerce-api/.env; production VPS:
# api.env, generated by tools/scripts/init-commerce-production-env.sh).
# Never commit a filled-in copy: .env* is git-ignored except .env.example.
# Every secret below is documented with its blast radius and rotation
# procedure in docs/security.md.

# --- Boot: required, the API refuses to start without them -----------------
# NODE_ENV: development | production (loadEnv; medusa-config reads it).
NODE_ENV=
# AGESTYLES_COMMERCE_ENV: lab | production. Selects the DATABASE_URL pattern
# and the loopback Redis port the config enforces (lab 15472/16392,
# production 15473/16393). Anything else fails boot.
AGESTYLES_COMMERCE_ENV=
# DATABASE_URL: lab must match
#   postgres://agestyles_lab:<hex>@127.0.0.1:15472/agestyles_mercur_lab
# production must match
#   postgres://agestyles_production:<hex>@127.0.0.1:15473/agestyles_commerce
# (pattern enforced in medusa-config.ts; loopback only).
DATABASE_URL=
# REDIS_URL: lab redis://127.0.0.1:16392, production redis://127.0.0.1:16393.
REDIS_URL=
# JWT_SECRET: signs Medusa auth JWTs (Bearer). Rotate per docs/security.md.
JWT_SECRET=
# COOKIE_SECRET: signs Medusa session cookies. Rotate per docs/security.md.
COOKIE_SECRET=

# --- File storage -----------------------------------------------------------
# AGESTYLES_FILE_STORAGE_PROVIDER: local | s3. Local writes to
# AGESTYLES_MEDIA_DIR and serves at AGESTYLES_MEDIA_URL (AG-26); s3 needs
# every S3_* variable below or boot fails.
AGESTYLES_FILE_STORAGE_PROVIDER=
# Local provider (both or neither; DIR must be absolute, URL public HTTPS).
AGESTYLES_MEDIA_DIR=
AGESTYLES_MEDIA_URL=
# S3 provider (loopback MinIO or a Supabase Storage S3 endpoint; S3_FILE_URL
# must be public HTTPS; prefix keeps new uploads apart from legacy files).
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_PREFIX=

# --- Transactional email (AG-19) -------------------------------------------
# Both or neither: with only one set the API refuses to start. The sender
# must be verified in SendGrid (ideally SPF/DKIM for the domain).
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# --- AI Studio (AG-27) ------------------------------------------------------
# Text-provider keys, tried in this order: Gemini, OpenRouter, Groq. With
# none set, «Sugerir con IA» is off. Models are optional overrides.
GEMINI_API_KEY=
AGESTYLES_AI_GEMINI_MODEL=
OPENROUTER_API_KEY=
AGESTYLES_AI_OPENROUTER_MODEL=
GROQ_API_KEY=
AGESTYLES_AI_GROQ_MODEL=
# AGESTYLES_AI_MONTHLY_LIMIT: drafts per store per month (default 100).
AGESTYLES_AI_MONTHLY_LIMIT=
# AGESTYLES_BACKGROUND_REMOVER_URL: self-hosted remover service base URL.
# Without it, background removal is disabled.
AGESTYLES_BACKGROUND_REMOVER_URL=

# --- Notifications / push (AG-19) ------------------------------------------
# EXPO_ACCESS_TOKEN: optional, extra security for the Expo push service.
EXPO_ACCESS_TOKEN=
# AGESTYLES_EXPO_API_URL / AGESTYLES_NOTIFICATIONS_QUIET_HOURS: LAB/CI ONLY.
# Never set them in production: push would go to a foreign URL / at night.
AGESTYLES_EXPO_API_URL=
AGESTYLES_NOTIFICATIONS_QUIET_HOURS=
# Public web origins used in password-reset links (HTTPS, no trailing slash).
# Without them the reset email is skipped. Store = customers, Business = members.
AGESTYLES_STORE_WEB_URL=
AGESTYLES_BUSINESS_WEB_URL=
# AGESTYLES_LOW_STOCK_THRESHOLD: units that trigger a low-stock alert (default 3).
AGESTYLES_LOW_STOCK_THRESHOLD=
# AGESTYLES_API_SELF_URL: base URL the API uses to call itself (storefront
# catalog); defaults to http://127.0.0.1:<PORT or 9000.
AGESTYLES_API_SELF_URL=
PORT=

# --- Exchange rate ----------------------------------------------------------
# ELTOQUE_API_TOKEN: ElToque rate API, used by the sync-eltoque-rate job.
ELTOQUE_API_TOKEN=

# --- Legacy catalog (Supabase, AG-32 migration) ----------------------------
# Read-only public key of the old catalog, used for legacy logins.
AGESTYLES_LEGACY_SUPABASE_URL=
AGESTYLES_LEGACY_SUPABASE_ANON_KEY=
# One-off import scripts only (never in api.env): the legacy project's
# service_role key. See docs/security.md — it must be revoked or its
# revocation confirmed after the AG-32 migration.
LEGACY_SUPABASE_URL=
LEGACY_SUPABASE_SERVICE_KEY=
# Source catalog export (import scripts only).
AGESTYLES_SOURCE_SUPABASE_URL=
AGESTYLES_SOURCE_SUPABASE_ANON_KEY=
AGESTYLES_SOURCE_CATALOG_EXPORT_ALLOW=

# --- Lab / CI only (never in production api.env) ---------------------------
# Password for the demo sellers created by `pnpm seed`. No default exists:
# seeding fails without it. CI sets a disposable value per run.
AGESTYLES_LAB_SEEDED_PASSWORD=
# Variables the lab verify scripts read (disposable lab only):
# EXPO_PUBLIC_MEDUSA_URL, EXPO_PUBLIC_MEDUSA_PUBLISHABLE_API_KEY, DATABASE_URL,
# AGESTYLES_LAB_API_BASE, AGESTYLES_LAB_PUBLISHABLE_KEY,
# AGESTYLES_LAB_PRICE_SELLER_EMAIL, AGESTYLES_LAB_QUOTE_ID,
# AGESTYLES_LAB_QUOTE_REVISION, AGESTYLES_LAB_CUSTOMER_TOKEN,
# DUAL_AUTH_LAB_EMAIL, DUAL_AUTH_LAB_PASSWORD, AGESTYLES_CI_DISPOSABLE.

# --- One-off / maintenance scripts (private shell, never api.env) -----------
# AGESTYLES_OFFICIAL_OWNER_EMAIL / AGESTYLES_OFFICIAL_OWNER_PASSWORD: owner
# of the official store (create-official-seller.ts).
# AGESTYLES_OFFICIAL_COMMERCE_APPLY, AGESTYLES_OFFICIAL_OFFER_PLAN,
# AGESTYLES_OFFICIAL_PUBLISH_APPLY, AGESTYLES_OFFICIAL_SYNC_STOCK,
# AGESTYLES_OFFICIAL_WHATSAPP_PHONE: official-store setup/import flags.
# AUTH_IDENTITY_ID, SELLER_HANDLE, MEMBER_ROLE, DRY_RUN: add-store-member.ts.
# LEGACY_DRY_RUN, LEGACY_CUSTOMER_ID: legacy-promote-admin.ts.
# AGESTYLES_DEMO_ACTION, AGESTYLES_DEMO_CONFIRM, AGESTYLES_DEMO_IMAGES_DIR,
# AGESTYLES_DEMO_PHOTOS_DIR: demo-stores.ts.
# AGESTYLES_PRODUCTION_*: production import (see docs/runbooks/commerce-production-vps.md):
# AGESTYLES_PRODUCTION_OFFICIAL_SELLER_ID, AGESTYLES_PRODUCTION_ADMIN_BEARER_TOKEN,
# AGESTYLES_PRODUCTION_IMPORT_APPLY, AGESTYLES_PRODUCTION_DB_ALLOW_WRITE,
# AGESTYLES_PRODUCTION_API_URL, AGESTYLES_PRODUCTION_REUSE_SOURCE_IMAGES.

# --- Production Compose private file (compose.env, NOT api.env) -------------
# AGESTYLES_PRODUCTION_IMAGE (image digest), AGESTYLES_PRODUCTION_API_ENV_FILE
# (absolute path to api.env), AGESTYLES_PRODUCTION_POSTGRES_PASSWORD (hex),
# AGESTYLES_PRODUCTION_MINIO_USER, AGESTYLES_PRODUCTION_MINIO_PASSWORD,
# MINIO_ROOT_USER, MINIO_ROOT_PASSWORD.
# Frontend public vars (EXPO_PUBLIC_MEDUSA_URL,
# EXPO_PUBLIC_MEDUSA_PUBLISHABLE_API_KEY, EXPO_PUBLIC_SUPABASE_URL,
# EXPO_PUBLIC_SUPABASE_ANON_KEY, NEXT_PUBLIC_MEDUSA_URL,
# NEXT_PUBLIC_MEDUSA_PUBLISHABLE_API_KEY, NEXT_PUBLIC_SUPABASE_URL,
# NEXT_PUBLIC_SUPABASE_ANON_KEY, EXPO_PUBLIC_STORE_WEB_URL,
# EXPO_PUBLIC_BUSINESS_WEB_URL, EXPO_PUBLIC_BUYER_MEDUSA_URL,
# EXPO_PUBLIC_BUSINESS_WEB_URL, EXPO_PUBLIC_ANDROID_APK_URL,
# MEDUSA_BACKEND_URL, MEDUSA_PUBLISHABLE_API_KEY, SITE_URL,
# BUSINESS_WEB_MEDUSA_URL, BUSINESS_WEB_BUYER_MEDUSA_URL, BUYER_APP_URL)
# belong to the apps that read them, not to this file.
