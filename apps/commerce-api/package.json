{
  "name": "@agestyles/commerce-api",
  "version": "0.0.0",
  "private": true,
  "nx": {
    "implicitDependencies": [
      "@agestyles/quotations"
    ]
  },
  "scripts": {
    "build:workspace-modules": "pnpm --filter @agestyles/quotations build && pnpm --filter @agestyles/catalog-pim build && pnpm --filter @agestyles/manual-payments build && pnpm --filter @agestyles/inventory-movements build && pnpm --filter @agestyles/sales-commissions build && pnpm --filter @agestyles/ai-studio build && pnpm --filter @agestyles/notifications build",
    "build": "pnpm build:workspace-modules && medusa build",
    "typecheck": "pnpm build:workspace-modules && tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "migrate": "medusa db:migrate",
    "start": "medusa start --host 127.0.0.1 --port 19081",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "verify:order-quote-expiry": "node --env-file=../../apps/commerce-api/.env --env-file=../../apps/buyer-app/.env.local scripts/verify-order-quote-expiry.mjs"
  },
  "dependencies": {
    "@agestyles/catalog-pim": "workspace:*",
    "@agestyles/domain": "workspace:*",
    "@agestyles/inventory-movements": "workspace:*",
    "@agestyles/manual-payments": "workspace:*",
    "@agestyles/ai-studio": "workspace:*",
    "@agestyles/notifications": "workspace:*",
    "@agestyles/sales-commissions": "workspace:*",
    "@medusajs/admin-sdk": "2.22.3",
    "@medusajs/cli": "2.22.3",
    "@medusajs/draft-order": "2.22.3",
    "@medusajs/framework": "2.22.3",
    "@medusajs/medusa": "2.22.3",
    "@mercurjs/core": "2.4.1",
    "@mercurjs/types": "2.4.1",
    "http-proxy-middleware": "3.0.7"
  },
  "devDependencies": {
    "@swc/core": "1.15.3",
    "ts-node": "10.9.2"
  }
}
