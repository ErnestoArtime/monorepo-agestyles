{
  "name": "@agestyles/commerce-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "migrate": "medusa db:migrate",
    "start": "medusa start --host 127.0.0.1 --port 19081",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "verify:order-quote-expiry": "node --env-file=../../apps/commerce-api/.env --env-file=../../apps/buyer-app/.env.local scripts/verify-order-quote-expiry.mjs"
  },
  "dependencies": {
    "@agestyles/domain": "workspace:*",
    "@agestyles/catalog-pim": "workspace:*",
    "@agestyles/manual-payments": "workspace:*",
    "@medusajs/admin-sdk": "2.22.3",
    "@medusajs/cli": "2.22.3",
    "@medusajs/draft-order": "2.22.3",
    "@medusajs/framework": "2.22.3",
    "@medusajs/medusa": "2.22.3",
    "@mercurjs/core": "2.4.1",
    "@mercurjs/types": "2.4.1",
    "http-proxy-middleware": "3.0.7"
  },
  "devDependencies": {
    "@swc/core": "1.15.3",
    "ts-node": "10.9.2"
  }
}
