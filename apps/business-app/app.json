{
  "expo": {
    "name": "AgeStyles Negocio",
    "slug": "agestyles-business-lab",
    "version": "1.3.2",
    "orientation": "portrait",
    "scheme": "agestyles-business-lab",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.eavlabs.agestyles.businesslab",
      "versionCode": 7,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/icon.png"
      }
    },
    "plugins": ["expo-router", "expo-notifications"],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/images/icon.png"
  }
}
