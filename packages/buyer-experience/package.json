{
  "name": "@agestyles/buyer-experience",
  "version": "0.0.0",
  "private": true,
  "description": "Tienda buyer experience for Expo (route tree, screens, providers and components) shared by apps/buyer-app and the buyer mode of apps/business-app (AG-31). The host app configures the customer client and the mount path with configureBuyerExperience().",
  "type": "module",
  "exports": {
    "./config": "./src/config.ts",
    "./routes/*": "./src/routes/*.tsx",
    "./components/*": "./src/components/*.tsx",
    "./context/*": "./src/context/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./constants/*": "./src/constants/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agestyles/api-client": "workspace:*",
    "@agestyles/design-tokens": "workspace:*",
    "@agestyles/features-buyer": "workspace:*",
    "@agestyles/features-notifications": "workspace:*",
    "@agestyles/icons": "workspace:*",
    "@agestyles/ui-native": "workspace:*"
  },
  "peerDependencies": {
    "@medusajs/js-sdk": "2.22.3",
    "@medusajs/types": "2.22.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/drawer": "^7.7.2",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.10",
    "expo-router": "~6.0.13",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0"
  },
  "devDependencies": {
    "@types/react": "19.1.17"
  }
}
