    "@agestyles/ui-native": "workspace:*"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo-constants": "~18.0.10",
    "expo-notifications": "~0.32.17",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@types/react": "19.1.17"
  }
}
