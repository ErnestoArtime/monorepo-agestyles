{
  "name": "@agestyles/manual-payments",
  "version": "0.0.0",
  "private": true,
  "description": "AgeStyles manual payment proofs module for Medusa v2",
  "keywords": [
    "agestyles",
    "medusa-module",
    "payments",
    "manual-payment"
  ],
  "medusaModule": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "default": "./dist/validation.js"
    }
  },
  "peerDependencies": {
    "@medusajs/framework": "2.22.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node test/manual-payments.test.ts"
  }
}
